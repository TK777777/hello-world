<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>运维导航与工具箱</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 40px; }
        h1 { text-align: center; margin-bottom: 30px; }
        .header-bar { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto 20px auto; }
        button { background: #3b82f6; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; }
        button:hover { background: #2563eb; }
        .container { max-width: 1200px; margin: 0 auto; }
        .category-section { margin-bottom: 30px; }
        .category-title { font-size: 1.25rem; border-bottom: 2px solid #334155; padding-bottom: 8px; margin-bottom: 15px; color: #38bdf8; }
        .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; }
        .card { background: #1e293b; padding: 15px; border-radius: 8px; border: 1px solid #334155; transition: transform 0.2s; }
        .card:hover { transform: translateY(-3px); border-color: #38bdf8; }
        .card a { color: #f8fafc; text-decoration: none; font-size: 1.1rem; font-weight: bold; display: block; margin-bottom: 5px; }
        .card p { color: #94a3b8; font-size: 0.9rem; margin: 0; }
        
        /* 弹窗样式 */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); justify-content: center; align-items: center; }
        .modal-content { background: #1e293b; padding: 30px; border-radius: 8px; width: 400px; border: 1px solid #334155; }
        .modal-content input, .modal-content select { width: 100%; padding: 8px; margin: 10px 0 20px 0; background: #0f172a; border: 1px solid #475569; color: white; border-radius: 4px; box-sizing: border-box; }
        .modal-buttons { display: flex; justify-content: flex-end; gap: 10px; }
        .btn-secondary { background: #475569; }
    </style>
</head>
<body>

    <div class="header-bar">
        <h1>🚀运维导航</h1>
        <button onclick="openModal()">+ 录入新网址</button>
    </div>

    <div class="container" id="app">
        <!-- 动态渲染内容 -->
    </div>

    <!-- 录入弹窗 -->
    <div class="modal" id="linkModal">
        <div class="modal-content">
            <h3>录入新网址</h3>
            <label>分类</label>
            <select id="category">
                <option value="监控">监控</option>
                <option value="CI/CD">CI/CD</option>
                <option value="工具">工具</option>
                <option value="网络">网络</option>
                <option value="官网">官网</option>
                <option value="支持">支持</option>
            </select>
            
            <label>名称</label>
            <input type="text" id="name" placeholder="例如: Prometheus">
            
            <label>URL 地址</label>
            <input type="text" id="url" placeholder="http://...">
            
            <label>描述</label>
            <input type="text" id="desc" placeholder="简短描述...">
            
            <div class="modal-buttons">
                <button class="btn-secondary" onclick="closeModal()">取消</button>
                <button onclick="submitLink()">保存</button>
            </div>
        </div>
    </div>

    <script>
        // 页面加载时获取数据
        window.onload = loadLinks;

        function loadLinks() {
            fetch('/api/links')
                .then(res => res.json())
                .then(data => {
                    const container = document.getElementById('app');
                    container.innerHTML = '';
                    
                    for (const [category, links] of Object.entries(data)) {
                        let cardsHTML = links.map(link => `
                            <div class="card">
                                <a href="${link.url}" target="_blank">${link.name} 🔗</a>
                                <p>${link.desc || '暂无描述'}</p>
                            </div>
                        `).join('');

                        container.innerHTML += `
                            <div class="category-section">
                                <div class="category-title">${category}</div>
                                <div class="card-grid">${cardsHTML}</div>
                            </div>
                        `;
                    }
                });
        }

        function openModal() { document.getElementById('linkModal').style.display = 'flex'; }
        function closeModal() { document.getElementById('linkModal').style.display = 'none'; }

        function submitLink() {
            const category = document.getElementById('category').value;
            const name = document.getElementById('name').value;
            const url = document.getElementById('url').value;
            const desc = document.getElementById('desc').value;

            if (!name || !url) {
                alert('请填写名称和URL');
                return;
            }

            fetch('/api/links', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ category, name, url, desc })
            }).then(res => res.json()).then(res => {
                if(res.success) {
                    closeModal();
                    loadLinks();
                    // 清空输入框
                    document.getElementById('name').value = '';
                    document.getElementById('url').value = '';
                    document.getElementById('desc').value = '';
                } else {
                    alert('保存失败');
                }
            });
        }
    </script>
</body>
</html>
