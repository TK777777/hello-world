<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>运维导航中心</title>
    <link rel="icon" id="favicon" href="https://api.iconify.design/fluent-emoji-flat:robot.svg">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; display: flex; min-height: 100vh; box-sizing: border-box; }
        
        /* 奔跑的像素小人样式（多帧像素拼接动画） */
        #pixel-runner { position: fixed; width: 32px; height: 32px; image-rendering: pixelated; pointer-events: none; z-index: 9999; transform: translate(-50%, -50%); }

        /* 左侧目录导航栏 */
        .sidebar { width: 240px; background: #1e293b; border-right: 1px solid #334155; padding: 30px 20px; display: flex; flex-direction: column; position: fixed; height: 100vh; box-sizing: border-box; }
        .sidebar h2 { font-size: 1.1rem; color: #94a3b8; margin-top: 0; margin-bottom: 20px; text-transform: uppercase; letter-spacing: 1px; }
        .sidebar-menu { list-style: none; padding: 0; margin: 0; overflow-y: auto; flex: 1; }
        .sidebar-menu li { padding: 10px 15px; margin-bottom: 8px; border-radius: 6px; cursor: pointer; color: #cbd5e1; transition: all 0.2s; font-weight: 500; }
        .sidebar-menu li:hover, .sidebar-menu li.active { background: #3b82f6; color: white; }

        /* 右侧主体内容区 */
        .main-content { margin-left: 240px; flex: 1; padding: 40px; padding-bottom: 90px; box-sizing: border-box; position: relative; }

        .header-bar { display: flex; justify-content: space-between; align-items: center; max-width: 1100px; margin: 0 auto 30px auto; }
        .logo-area { display: flex; align-items: center; gap: 15px; }
        
        /* 头像上传相关样式 */
        .avatar-container { position: relative; cursor: pointer; display: inline-block; }
        .avatar-img { width: 48px; height: 48px; border-radius: 10px; object-fit: cover; border: 2px solid #334155; background: #1e293b; transition: border-color 0.2s; }
        .avatar-container:hover .avatar-img { border-color: #38bdf8; }
        .avatar-mask { position: absolute; bottom: 0; right: 0; background: rgba(0,0,0,0.7); color: white; font-size: 9px; padding: 2px 4px; border-radius: 4px; opacity: 0; transition: opacity 0.2s; }
        .avatar-container:hover .avatar-mask { opacity: 1; }

        .btn-group { display: flex; gap: 10px; }
        button { background: #3b82f6; color: white; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; }
        button:hover { background: #2563eb; }
        .btn-danger { background: #ef4444; }
        .btn-danger:hover { background: #dc2626; }
        .btn-secondary { background: #475569; }
        .btn-secondary:hover { background: #334155; }

        .container { max-width: 1100px; margin: 0 auto; }
        
        .category-section { margin-bottom: 35px; background: #1e293b; padding: 20px; border-radius: 10px; border: 1px solid #334155; transition: box-shadow 0.3s, border-color 0.3s; }
        .category-section.highlight { border-color: #38bdf8; box-shadow: 0 0 15px rgba(56, 189, 248, 0.3); }
        
        .category-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #334155; padding-bottom: 10px; margin-bottom: 15px; }
        .category-title { font-size: 1.25rem; color: #38bdf8; font-weight: bold; }
        
        .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 15px; }
        .card { background: #0f172a; padding: 15px; border-radius: 8px; border: 1px solid #334155; position: relative; transition: transform 0.2s; }
        .card:hover { transform: translateY(-3px); border-color: #38bdf8; }
        .card a { color: #f8fafc; text-decoration: none; font-size: 1.1rem; font-weight: bold; display: block; margin-bottom: 5px; }
        .card a:hover { color: #38bdf8; }
        .card p { color: #94a3b8; font-size: 0.9rem; margin: 0; }
        
        .delete-link-btn { position: absolute; top: 10px; right: 10px; background: transparent; color: #64748b; border: none; font-size: 14px; cursor: pointer; padding: 2px 6px; }
        .delete-link-btn:hover { color: #ef4444; }

        .footer { position: absolute; bottom: 20px; width: calc(100% - 80px); text-align: center; color: #64748b; font-size: 0.9rem; }

        /* 弹窗通用样式 */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); justify-content: center; align-items: center; z-index: 1000; }
        .modal-content { background: #1e293b; padding: 30px; border-radius: 8px; width: 450px; border: 1px solid #334155; }
        .modal-content input, .modal-content select { width: 100%; padding: 8px; margin: 8px 0 16px 0; background: #0f172a; border: 1px solid #475569; color: white; border-radius: 4px; box-sizing: border-box; }
        .modal-buttons { display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; }
    </style>
</head>
<body>

    <!-- 奔跑的像素小人（通过 SVG 动态渲染） -->
    <div id="pixel-runner"></div>

    <!-- 左侧目录导航 -->
    <div class="sidebar">
        <h2>导航目录</h2>
        <ul class="sidebar-menu" id="sidebarMenu">
            <!-- 动态注入分类目录 -->
        </ul>
    </div>

    <!-- 右侧内容 -->
    <div class="main-content">
        <div class="header-bar">
            <div class="logo-area">
                <!-- 头像支持点击更换并持久化 -->
                <div class="avatar-container" onclick="document.getElementById('avatarInput').click()" title="点击更换头像">
                    <img id="siteAvatar" src="/api/avatar" onerror="this.src='https://api.iconify.design/fluent-emoji-flat:robot.svg'" class="avatar-img" alt="Avatar">
                    <div class="avatar-mask">更换</div>
                </div>
                <input type="file" id="avatarInput" style="display:none" accept="image/*" onchange="uploadAvatar(this)">
                <h1 style="margin: 0; font-size: 1.8rem;">运维导航中心</h1>
            </div>
            <div class="btn-group">
                <button onclick="openLinkModal()">+ 录入新网址 / 管理分类</button>
            </div>
        </div>

        <div class="container" id="app">
            <!-- 动态渲染内容 -->
        </div>

        <div class="footer">
            联系邮箱：xxx@edsz9.com
        </div>
    </div>

    <!-- 录入网址与分类综合管理弹窗 -->
    <div class="modal" id="linkModal">
        <div class="modal-content" style="width: 500px;">
            <h3>资源与分类管理</h3>
            
            <!-- 1. 新建与删除分类子区域 -->
            <div style="background: #0f172a; padding: 12px; border-radius: 6px; margin-bottom: 15px; border: 1px solid #334155;">
                <label style="font-size: 0.9rem; color: #38bdf8; font-weight: bold;">分类管理</label>
                <div style="display: flex; gap: 8px; margin-top: 8px;">
                    <input type="text" id="newCategoryName" placeholder="新分类名称" style="margin:0; flex:1;">
                    <button onclick="submitCategory()" style="padding: 0 14px;">新建分类</button>
                </div>
                <div style="margin-top: 10px; display: flex; justify-content: space-between; align-items: center;">
                    <select id="deleteCategorySelect" style="margin:0; flex:1; background:#1e293b;"></select>
                    <button class="btn-danger" onclick="promptDeleteCategory()" style="margin-left: 8px; padding: 8px 12px; font-size: 0.85rem;">安全删除分类</button>
                </div>
            </div>

            <hr style="border:0; border-top:1px solid #334155; margin: 15px 0;">

            <!-- 2. 录入新网址子区域 -->
            <label style="font-size: 0.9rem; color: #38bdf8; font-weight: bold;">录入新网址</label>
            <label>目标分类</label>
            <select id="linkCategorySelect"></select>
            
            <label>名称</label>
            <input type="text" id="linkName" placeholder="例如: Prometheus">
            
            <label>URL 地址</label>
            <input type="text" id="linkUrl" placeholder="http://...">
            
            <label>描述</label>
            <input type="text" id="linkDesc" placeholder="简短描述...">
            
            <div class="modal-buttons">
                <button class="btn-secondary" onclick="closeLinkModal()">关闭窗口</button>
                <button onclick="submitLink()">保存网址</button>
            </div>
        </div>
    </div>

    <!-- 统一安全密码认证弹窗 -->
    <div class="modal" id="securityModal">
        <div class="modal-content">
            <h3 style="color: #ef4444;" id="securityTitle">安全确认</h3>
            <p id="securityTip" style="color: #94a3b8; font-size: 0.9rem;"></p>
            <label>请输入删除密码</label>
            <input type="password" id="actionPassword" placeholder="请输入密码">
            
            <div class="modal-buttons">
                <button class="btn-secondary" onclick="closeSecurityModal()">取消</button>
                <button class="btn-danger" onclick="executeSecuredAction()">确认执行</button>
            </div>
        </div>
    </div>

    <script>
        let globalData = {};
        let currentActionCallback = null;

        window.onload = () => {
            loadLinks();
            initPixelRunner();
        };

        function loadLinks() {
            fetch('/api/links')
                .then(res => res.json())
                .then(data => {
                    globalData = data;
                    const container = document.getElementById('app');
                    const sidebarMenu = document.getElementById('sidebarMenu');
                    const linkSelect = document.getElementById('linkCategorySelect');
                    const deleteSelect = document.getElementById('deleteCategorySelect');
                    
                    container.innerHTML = '';
                    sidebarMenu.innerHTML = '';
                    linkSelect.innerHTML = '';
                    deleteSelect.innerHTML = '';
                    
                    for (const [category, links] of Object.entries(data)) {
                        // 填充左侧目录
                        sidebarMenu.innerHTML += `<li onclick="scrollToCategory('${category}')">${category}</li>`;

                        // 填充弹窗下拉菜单
                        linkSelect.innerHTML += `<option value="${category}">${category}</option>`;
                        deleteSelect.innerHTML += `<option value="${category}">${category}</option>`;

                        // 渲染主卡片区
                        let cardsHTML = links.length > 0 ? links.map((link, index) => `
                            <div class="card">
                                <button class="delete-link-btn" title="删除该网址" onclick="promptDeleteLink('${category}', ${index}, '${link.name}')">×</button>
                                <a href="${link.url}" target="_blank">${link.name}</a>
                                <p>${link.desc || '暂无描述'}</p>
                            </div>
                        `).join('') : '<p style="color: #64748b; font-size: 0.9rem;">该分类下暂无网址</p>';

                        container.innerHTML += `
                            <div class="category-section" id="cat-${category}">
                                <div class="category-header">
                                    <div class="category-title">${category}</div>
                                </div>
                                <div class="card-grid">${cardsHTML}</div>
                            </div>
                        `;
                    }
                });
        }

        // 点击左侧目录跳转并放大高亮对应分类
        function scrollToCategory(category) {
            const el = document.getElementById(`cat-${category}`);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                el.classList.add('highlight');
                setTimeout(() => {
                    el.classList.remove('highlight');
                }, 1500);
            }
            // 侧边栏激活状态切换
            document.querySelectorAll('.sidebar-menu li').forEach(li => {
                if (li.innerText === category) li.classList.add('active');
                else li.classList.remove('active');
            });
        }

        // 弹窗控制
        function openLinkModal() { document.getElementById('linkModal').style.display = 'flex'; }
        function closeLinkModal() { document.getElementById('linkModal').style.display = 'none'; }

        function openSecurityModal(title, tip, callback) {
            document.getElementById('securityTitle').innerText = title;
            document.getElementById('securityTip').innerText = tip;
            document.getElementById('actionPassword').value = '';
            currentActionCallback = callback;
            document.getElementById('securityModal').style.display = 'flex';
        }
        function closeSecurityModal() { document.getElementById('securityModal').style.display = 'none'; }

        function executeSecuredAction() {
            const password = document.getElementById('actionPassword').value;
            if (currentActionCallback) currentActionCallback(password);
        }

        // 头像上传逻辑
        function uploadAvatar(input) {
            if (input.files && input.files[0]) {
                const formData = new FormData();
                formData.append('avatar', input.files[0]);
                fetch('/api/avatar', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(res => {
                    if(res.success) {
                        const newSrc = '/api/avatar?t=' + new Date().getTime();
                        document.getElementById('siteAvatar').src = newSrc;
                        document.getElementById('favicon').href = newSrc;
                    } else {
                        alert(res.message || '头像上传失败');
                    }
                });
            }
        }

        // 新建分类
        function submitCategory() {
            const category = document.getElementById('newCategoryName').value.trim();
            if (!category) { alert('分类名称不能为空'); return; }

            fetch('/api/category', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ category })
            }).then(res => res.json()).then(res => {
                if(res.success) {
                    loadLinks();
                    document.getElementById('newCategoryName').value = '';
                    alert('分类创建成功');
                } else { alert(res.message || '创建失败'); }
            });
        }

        // 触发安全删除分类
        function promptDeleteCategory() {
            const category = document.getElementById('deleteCategorySelect').value;
            if (!category) { alert('请选择要删除的分类'); return; }
            
            openSecurityModal(
                "安全确认：删除分类",
                `您正在尝试删除分类【${category}】。此操作将清空其下所有网址，请输入密码确认：`,
                (password) => {
                    fetch('/api/category', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ category, password })
                    }).then(res => res.json()).then(res => {
                        if(res.success) {
                            closeSecurityModal();
                            loadLinks();
                        } else { alert(res.message || '删除失败'); }
                    });
                }
            );
        }

        // 触发安全删除网址
        function promptDeleteLink(category, index, name) {
            openSecurityModal(
                "安全确认：删除网址",
                `您正在尝试删除网址【${name}】。请输入密码确认：`,
                (password) => {
                    fetch('/api/links', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ category, index, password })
                    }).then(res => res.json()).then(res => {
                        if(res.success) {
                            closeSecurityModal();
                            loadLinks();
                        } else { alert(res.message || '删除失败'); }
                    });
                }
            );
        }

        // 提交新网址
        function submitLink() {
            const category = document.getElementById('linkCategorySelect').value;
            const name = document.getElementById('linkName').value;
            const url = document.getElementById('linkUrl').value;
            const desc = document.getElementById('linkDesc').value;

            if (!name || !url) { alert('请填写名称和URL'); return; }

            fetch('/api/links', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ category, name, url, desc })
            }).then(res => res.json()).then(res => {
                if(res.success) {
                    closeLinkModal();
                    loadLinks();
                    document.getElementById('linkName').value = '';
                    document.getElementById('linkUrl').value = '';
                    document.getElementById('linkDesc').value = '';
                } else { alert('保存失败'); }
            });
        }

        // 奔跑的像素小人动画逻辑
        function initPixelRunner() {
            const runner = document.getElementById('pixel-runner');
            // 使用内联精美像素小人 SVG 动态帧
            const frames = [
                `<svg width="32" height="32" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><path d="M6 2h4v2H6zM5 5h6v3H5zm1 4h4v2H6zm-1 3h2v3H5zm4 0h2v3H9z" fill="#38bdf8"/></svg>`,
                `<svg width="32" height="32" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg"><path d="M6 2h4v2H6zM5 5h6v3H5zm1 4h4v2H6zm0 3h2v3H6zm3 1h2v2H9z" fill="#38bdf8"/></svg>`
            ];
            
            let mouseX = window.innerWidth / 2;
            let mouseY = window.innerHeight / 2;
            let posX = mouseX;
            let posY = mouseY;
            let frameIdx = 0;
            let lastFrameTime = 0;

            window.addEventListener('mousemove', (e) => {
                mouseX = e.pageX;
                mouseY = e.pageY;
            });

            function animate(timestamp) {
                posX += (mouseX - posX - 16) * 0.1;
                posY += (mouseY - posY - 16) * 0.1;
                runner.style.left = `${posX}px`;
                runner.style.top = `${posY}px`;

                // 切换动画帧模拟奔跑
                if (timestamp - lastFrameTime > 150) {
                    frameIdx = (frameIdx + 1) % frames.length;
                    runner.innerHTML = frames[frameIdx];
                    lastFrameTime = timestamp;
                }
                requestAnimationFrame(animate);
            }
            requestAnimationFrame(animate);
        }
    </script>
</body>
</html>
