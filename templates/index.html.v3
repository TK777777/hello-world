<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <title>运维导航中心</title>
    <!-- 浏览器的标签页图标：支持自定义头像链接 -->
    <link rel="icon" id="favicon" href="https://api.iconify.design/fluent-emoji-flat:robot.svg">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 40px; position: relative; min-height: 100vh; box-sizing: border-box; padding-bottom: 80px; }
        
        /* 像素小人样式 */
        #pixel-pet { position: absolute; width: 24px; height: 24px; image-rendering: pixelated; pointer-events: none; z-index: 9999; background: #38bdf8; box-shadow: 0 0 8px #38bdf8; border-radius: 4px; transition: transform 0.1s linear; }

        .header-bar { display: flex; justify-content: space-between; align-items: center; max-width: 1200px; margin: 0 auto 30px auto; }
        .logo-area { display: flex; align-items: center; gap: 15px; }
        /* 标题前面的自定义头像 */
        .avatar-img { width: 42px; height: 42px; border-radius: 8px; object-fit: cover; border: 1px solid #334155; background: #1e293b; }
        
        .btn-group { display: flex; gap: 10px; }
        button { background: #3b82f6; color: white; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; }
        button:hover { background: #2563eb; }
        .btn-danger { background: #ef4444; }
        .btn-danger:hover { background: #dc2626; }
        .btn-secondary { background: #475569; }
        .btn-secondary:hover { background: #334155; }

        .container { max-width: 1200px; margin: 0 auto; }
        
        .category-section { margin-bottom: 35px; background: #1e293b; padding: 20px; border-radius: 10px; border: 1px solid #334155; }
        .category-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #334155; padding-bottom: 10px; margin-bottom: 15px; }
        .category-title { font-size: 1.25rem; color: #38bdf8; font-weight: bold; }
        
        .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; }
        .card { background: #0f172a; padding: 15px; border-radius: 8px; border: 1px solid #334155; position: relative; transition: transform 0.2s; }
        .card:hover { transform: translateY(-3px); border-color: #38bdf8; }
        .card a { color: #f8fafc; text-decoration: none; font-size: 1.1rem; font-weight: bold; display: block; margin-bottom: 5px; }
        .card a:hover { color: #38bdf8; }
        .card p { color: #94a3b8; font-size: 0.9rem; margin: 0; }
        
        /* 卡片上的删除小按钮 */
        .delete-link-btn { position: absolute; top: 10px; right: 10px; background: transparent; color: #64748b; border: none; font-size: 14px; cursor: pointer; padding: 2px 6px; }
        .delete-link-btn:hover { color: #ef4444; }

        /* 底部版权与联系邮箱 */
        .footer { position: absolute; bottom: 20px; width: 100%; left: 0; text-align: center; color: #64748b; font-size: 0.9rem; }

        /* 弹窗样式 */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); justify-content: center; align-items: center; z-index: 1000; }
        .modal-content { background: #1e293b; padding: 30px; border-radius: 8px; width: 400px; border: 1px solid #334155; }
        .modal-content input, .modal-content select { width: 100%; padding: 8px; margin: 10px 0 20px 0; background: #0f172a; border: 1px solid #475569; color: white; border-radius: 4px; box-sizing: border-box; }
        .modal-buttons { display: flex; justify-content: flex-end; gap: 10px; }
    </style>
</head>
<body>

    <!-- 像素小人元素 -->
    <div id="pixel-pet"></div>

    <div class="header-bar">
        <div class="logo-area">
            <!-- 自定义头像：可根据需要直接修改 src 地址 -->
            <img id="siteAvatar" src="https://api.iconify.design/fluent-emoji-flat:robot.svg" class="avatar-img" alt="Avatar">
            <h1 style="margin: 0; font-size: 1.8rem;">运维导航中心</h1>
        </div>
        <div class="btn-group">
            <button onclick="openCategoryModal()">+ 新建分类</button>
            <button onclick="openLinkModal()">+ 录入新网址</button>
            <button class="btn-secondary" onclick="openManageCategoryModal()">管理分类</button>
        </div>
    </div>

    <div class="container" id="app">
        <!-- 动态渲染内容 -->
    </div>

    <div class="footer">
        联系邮箱：xxx@edsz9.com
    </div>

    <!-- 录入网址弹窗 -->
    <div class="modal" id="linkModal">
        <div class="modal-content">
            <h3>录入新网址</h3>
            <label>目标分类</label>
            <select id="linkCategorySelect"></select>
            
            <label>名称</label>
            <input type="text" id="linkName" placeholder="例如: Prometheus">
            
            <label>URL 地址</label>
            <input type="text" id="linkUrl" placeholder="http://...">
            
            <label>描述</label>
            <input type="text" id="linkDesc" placeholder="简短描述...">
            
            <div class="modal-buttons">
                <button class="btn-secondary" onclick="closeLinkModal()">取消</button>
                <button onclick="submitLink()">保存</button>
            </div>
        </div>
    </div>

    <!-- 新建分类弹窗 -->
    <div class="modal" id="categoryModal">
        <div class="modal-content">
            <h3>新建分类</h3>
            <label>分类名称</label>
            <input type="text" id="newCategoryName" placeholder="例如: 数据库">
            
            <div class="modal-buttons">
                <button class="btn-secondary" onclick="closeCategoryModal()">取消</button>
                <button onclick="submitCategory()">创建</button>
            </div>
        </div>
    </div>

    <!-- 集中管理分类弹窗（支持在此处安全删除分类） -->
    <div class="modal" id="manageCategoryModal">
        <div class="modal-content" style="width: 450px;">
            <h3>集中管理分类</h3>
            <p style="color: #94a3b8; font-size: 0.85rem;">选择要删除的分类（删除分类会同时清空其下网址，需输入密码）：</p>
            <div id="manageCategoryList" style="max-height: 200px; overflow-y: auto; margin: 15px 0;"></div>
            
            <div class="modal-buttons">
                <button class="btn-secondary" onclick="closeManageCategoryModal()">关闭</button>
            </div>
        </div>
    </div>

    <!-- 统一安全认证弹窗（用于删除分类或删除网址的密码校验） -->
    <div class="modal" id="securityModal">
        <div class="modal-content">
            <h3 style="color: #ef4444;" id="securityTitle">安全确认</h3>
            <p id="securityTip" style="color: #94a3b8; font-size: 0.9rem;"></p>
            <label>请输入删除密码</label>
            <input type="password" id="actionPassword" placeholder="请输入密码">
            
            <div class="modal-buttons">
                <button class="btn-secondary" onclick="closeSecurityModal()">取消</button>
                <button class="btn-danger" onclick="executeSecuredAction()">确认执行</button>
            </div>
        </div>
    </div>

    <script>
        let globalData = {};
        let currentActionCallback = null;

        window.onload = () => {
            loadLinks();
            initPixelPet();
        };

        function loadLinks() {
            fetch('/api/links')
                .then(res => res.json())
                .then(data => {
                    globalData = data;
                    const container = document.getElementById('app');
                    const select = document.getElementById('linkCategorySelect');
                    container.innerHTML = '';
                    select.innerHTML = '';
                    
                    for (const [category, links] of Object.entries(data)) {
                        select.innerHTML += `<option value="${category}">${category}</option>`;

                        let cardsHTML = links.length > 0 ? links.map((link, index) => `
                            <div class="card">
                                <button class="delete-link-btn" title="删除该网址" onclick="promptDeleteLink('${category}', ${index}, '${link.name}')">×</button>
                                <a href="${link.url}" target="_blank">${link.name}</a>
                                <p>${link.desc || '暂无描述'}</p>
                            </div>
                        `).join('') : '<p style="color: #64748b; font-size: 0.9rem;">该分类下暂无网址</p>';

                        container.innerHTML += `
                            <div class="category-section">
                                <div class="category-header">
                                    <div class="category-title">${category}</div>
                                </div>
                                <div class="card-grid">${cardsHTML}</div>
                            </div>
                        `;
                    }
                });
        }

        // 弹窗控制
        function openLinkModal() { document.getElementById('linkModal').style.display = 'flex'; }
        function closeLinkModal() { document.getElementById('linkModal').style.display = 'none'; }

        function openCategoryModal() { document.getElementById('categoryModal').style.display = 'flex'; }
        function closeCategoryModal() { document.getElementById('categoryModal').style.display = 'none'; }

        function openManageCategoryModal() {
            const listDiv = document.getElementById('manageCategoryList');
            listDiv.innerHTML = '';
            for (const category of Object.keys(globalData)) {
                listDiv.innerHTML += `
                    <div style="display: flex; justify-content: space-between; align-items: center; background: #0f172a; padding: 8px 12px; margin-bottom: 8px; border-radius: 4px; border: 1px solid #334155;">
                        <span>${category}</span>
                        <button class="btn-danger" style="padding: 4px 10px; font-size: 0.8rem;" onclick="promptDeleteCategory('${category}')">删除</button>
                    </div>
                `;
            }
            document.getElementById('manageCategoryModal').style.display = 'flex';
        }
        function closeManageCategoryModal() { document.getElementById('manageCategoryModal').style.display = 'none'; }

        function openSecurityModal(title, tip, callback) {
            document.getElementById('securityTitle').innerText = title;
            document.getElementById('securityTip').innerText = tip;
            document.getElementById('actionPassword').value = '';
            currentActionCallback = callback;
            document.getElementById('securityModal').style.display = 'flex';
        }
        function closeSecurityModal() { document.getElementById('securityModal').style.display = 'none'; }

        function executeSecuredAction() {
            const password = document.getElementById('actionPassword').value;
            if (currentActionCallback) {
                currentActionCallback(password);
            }
        }

        // 触发删除分类
        function promptDeleteCategory(category) {
            closeManageCategoryModal();
            openSecurityModal(
                "安全确认：删除分类",
                `您正在尝试删除分类【${category}】。此操作将同时清空该分类下的所有网址，请输入密码确认：`,
                (password) => {
                    fetch('/api/category', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ category, password })
                    }).then(res => res.json()).then(res => {
                        if(res.success) {
                            closeSecurityModal();
                            loadLinks();
                        } else {
                            alert(res.message || '删除失败');
                        }
                    });
                }
            );
        }

        // 触发删除网址
        function promptDeleteLink(category, index, name) {
            openSecurityModal(
                "安全确认：删除网址",
                `您正在尝试删除网址【${name}】。请输入密码确认：`,
                (password) => {
                    fetch('/api/links', {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ category, index, password })
                    }).then(res => res.json()).then(res => {
                        if(res.success) {
                            closeSecurityModal();
                            loadLinks();
                        } else {
                            alert(res.message || '删除失败');
                        }
                    });
                }
            );
        }

        // 提交表单
        function submitLink() {
            const category = document.getElementById('linkCategorySelect').value;
            const name = document.getElementById('linkName').value;
            const url = document.getElementById('linkUrl').value;
            const desc = document.getElementById('linkDesc').value;

            if (!name || !url) { alert('请填写名称和URL'); return; }

            fetch('/api/links', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ category, name, url, desc })
            }).then(res => res.json()).then(res => {
                if(res.success) {
                    closeLinkModal();
                    loadLinks();
                    document.getElementById('linkName').value = '';
                    document.getElementById('linkUrl').value = '';
                    document.getElementById('linkDesc').value = '';
                } else { alert('保存失败'); }
            });
        }

        function submitCategory() {
            const category = document.getElementById('newCategoryName').value.trim();
            if (!category) { alert('分类名称不能为空'); return; }

            fetch('/api/category', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ category })
            }).then(res => res.json()).then(res => {
                if(res.success) {
                    closeCategoryModal();
                    loadLinks();
                    document.getElementById('newCategoryName').value = '';
                } else { alert(res.message || '创建失败'); }
            });
        }

        // 像素小人追随鼠标移动动画逻辑
        function initPixelPet() {
            const pet = document.getElementById('pixel-pet');
            let mouseX = window.innerWidth / 2;
            let mouseY = window.innerHeight / 2;
            let petX = mouseX;
            let petY = mouseY;
            const speed = 0.08; // 追随平滑度

            window.addEventListener('mousemove', (e) => {
                mouseX = e.pageX;
                mouseY = e.pageY;
            });

            function animate() {
                petX += (mouseX - petX - 12) * speed;
                petY += (mouseY - petY - 12) * speed;
                pet.style.left = `${petX}px`;
                pet.style.top = `${petY}px`;
                requestAnimationFrame(animate);
            }
            animate();
        }
    </script>
</body>
</html>
